# ==============================================================================
# CommerceIQ — Monorepo Environment Configuration Template
# ==============================================================================

# Backend Server Configuration (Render Web Service)
NODE_ENV=development
PORT=5000

# Deployed frontend origin(s). Supports comma-separated list of trusted origins.
# Trailing slashes are automatically trimmed and normalized by the backend.
# In local development: http://localhost:5173
# In production: https://<your-vercel-app>.vercel.app
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas M0 Free Cluster)
# Example format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/commerceiq?retryWrites=true&w=majority
MONGODB_URI=

# Authentication Secret (Server-only)
# Generate a strong 64+ character random string in production
JWT_SECRET=

# Google Gemini AI Service (Server-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Database Seeding Configuration (Optional, Server-only)
# Target email for demo merchant account
SEED_EMAIL=demo@commerceiq.com
# Required when running seed script against a production database (NODE_ENV=production).
# Leave unset or false in production hosting environments (e.g., Render).
ALLOW_PRODUCTION_SEED=false

# Frontend Configuration (Vercel Build Environment)
# IMPORTANT: The deployed backend URL MUST include the /api suffix.
# In local development: http://localhost:5000/api
# In production: https://<your-render-service>.onrender.com/api
VITE_API_URL=http://localhost:5000/api
